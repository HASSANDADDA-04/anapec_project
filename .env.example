# ==============================================================
# Configuration Environnement - Projet ANAPEC
# Standard Cookiecutter Data Science & Application Déployée
# Copiez ce fichier vers .env ou backend/.env et adaptez les valeurs
# ==============================================================

# Base de données PostgreSQL
# Format local direct (lorsque Postgres tourne via docker-compose sur le port 5433) :
DATABASE_URL=postgresql+psycopg://anapec:anapec@localhost:5433/anapec

# Format conteneurisé (si backend tourne dans Docker) :
# DATABASE_URL=postgresql+psycopg://anapec:anapec@db:5432/anapec

# Sécurité & Authentification JWT
JWT_SECRET=anapec-dev-secret-change-me
JWT_HOURS=12

# Chemins des données (Standard Cookiecutter Data Science)
DATA_DIR=./data
RAW_DIR=./data/raw/esco
INTERIM_DIR=./data/interim
PROCESSED_DIR=./data/processed
EXTERNAL_DIR=./data/external
ESCO_DIR=./data/raw/esco

# Modèles, rapports et références
MODELS_DIR=./models
REPORTS_DIR=./reports
REFERENCES_DIR=./references
UPLOAD_DIR=./backend/uploads

# Configuration Frontend (Vite)
VITE_API_BASE=http://localhost:8000
